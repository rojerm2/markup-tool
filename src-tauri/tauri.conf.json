{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Markup",
  "version": "0.3.0",
  "identifier": "com.orcific.pdf-markup-tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/rust-licenses.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Markup",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "rojerm2",
    "homepage": "https://github.com/rojerm2/markup-tool",
    "copyright": "Copyright (c) 2026 rojerm2",
    "licenseFile": "../LICENSE",
    "shortDescription": "Highlight and annotate PDFs with portable editable projects.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../src/assets/LegendSans.LICENSE": "licenses/LegendSans.LICENSE",
      "../third_party/fonts/README.md": "licenses/font-source/README.md",
      "../third_party/fonts/liberation-fonts-1.07.4.tar.gz": "licenses/font-source/liberation-fonts-1.07.4.tar.gz",
      "../public/THIRD_PARTY_LICENSES.txt": "licenses/JAVASCRIPT_LICENSES.txt",
      "../public/RUST_LICENSES.txt": "licenses/RUST_LICENSES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
