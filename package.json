{
  "name": "pdf-markup-tool",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "lint": "eslint src tests *.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write . && npm run lint -- --fix --fix-type layout && npm run format:rust",
    "format:check": "prettier --check . && npm run lint && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:release": "node scripts/check-release.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "prepare": "node scripts/copy-pdf-assets.mjs && node scripts/rust-licenses.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.4",
    "vitest": "^5.0.0"
  },
  "description": "A local-first PDF markup editor with portable projects and vector export",
  "license": "MIT",
  "author": "rojerm2",
  "repository": {
    "type": "git",
    "url": "https://github.com/rojerm2/markup-tool.git"
  },
  "homepage": "https://github.com/rojerm2/markup-tool#readme",
  "bugs": {
    "url": "https://github.com/rojerm2/markup-tool/issues"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
